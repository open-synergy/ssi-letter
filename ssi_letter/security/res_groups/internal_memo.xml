<odoo>
<!-- Workflow-->
<record id="internal_memo_viewer_group" model="res.groups">
    <field name="name">Viewer</field>
    <field name="category_id" ref="internal_memo_workflow_module_category" />
</record>

<record id="internal_memo_user_group" model="res.groups">
    <field name="name">User</field>
    <field name="category_id" ref="internal_memo_workflow_module_category" />
    <field name="implied_ids" eval="[(4, ref('internal_memo_viewer_group'))]" />
</record>

<record id="internal_memo_validator_group" model="res.groups">
    <field name="name">Validator</field>
    <field name="category_id" ref="internal_memo_workflow_module_category" />
    <field name="implied_ids" eval="[(4, ref('internal_memo_user_group'))]" />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>


<!-- Data Ownership -->
<record id="internal_memo_company_group" model="res.groups">
    <field name="name">Company</field>
    <field name="category_id" ref="internal_memo_data_ownership_module_category" />
</record>

<record id="internal_memo_company_child_group" model="res.groups">
    <field name="name">Company and All Child Companies</field>
    <field name="category_id" ref="internal_memo_data_ownership_module_category" />
    <field name="implied_ids" eval="[(4, ref('internal_memo_company_group'))]" />
</record>

<record id="internal_memo_all_group" model="res.groups">
    <field name="name">All</field>
    <field name="category_id" ref="internal_memo_data_ownership_module_category" />
    <field name="implied_ids" eval="[(4, ref('internal_memo_company_child_group'))]" />
</record>
</odoo>
