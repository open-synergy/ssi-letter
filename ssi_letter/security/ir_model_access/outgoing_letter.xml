<odoo>
<record id="outgoing_letter_all_access" model="ir.model.access">
  <field name="name">outgoing_letter - all</field>
  <field name="model_id" ref="model_outgoing_letter" />
  <field name="group_id" eval="False" />
  <field name="perm_read" eval="1" />
  <field name="perm_write" eval="0" />
  <field name="perm_create" eval="0" />
  <field name="perm_unlink" eval="0" />
</record>
<record id="outgoing_letter_user_access" model="ir.model.access">
  <field name="name">outgoing_letter - user</field>
  <field name="model_id" ref="model_outgoing_letter" />
  <field name="group_id" ref="outgoing_letter_user_group" />
  <field name="perm_read" eval="1" />
  <field name="perm_write" eval="1" />
  <field name="perm_create" eval="1" />
  <field name="perm_unlink" eval="1" />
</record>
</odoo>
