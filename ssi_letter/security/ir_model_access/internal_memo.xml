<odoo>
<record id="internal_memo_all_access" model="ir.model.access">
  <field name="name">internal_memo - all</field>
  <field name="model_id" ref="model_internal_memo" />
  <field name="group_id" eval="False" />
  <field name="perm_read" eval="1" />
  <field name="perm_write" eval="0" />
  <field name="perm_create" eval="0" />
  <field name="perm_unlink" eval="0" />
</record>
<record id="internal_memo_user_access" model="ir.model.access">
  <field name="name">internal_memo - user</field>
  <field name="model_id" ref="model_internal_memo" />
  <field name="group_id" ref="internal_memo_user_group" />
  <field name="perm_read" eval="1" />
  <field name="perm_write" eval="1" />
  <field name="perm_create" eval="1" />
  <field name="perm_unlink" eval="1" />
</record>
</odoo>
