<odoo>
<record id="internal_memo_view_tree" model="ir.ui.view">
    <field name="name">internal_memo - Tree</field>
    <field name="model">internal_memo</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="field[@name='company_id']" position="after">
                <field name="date" />
                <field name="type_id" />
                <field name="title" />
                <field name="recipient_ids" widget="many2many_tags_avatar" />
            </xpath>
        </data>
    </field>
</record>

<record id="internal_memo_view_search" model="ir.ui.view">
    <field name="name">internal_memo - Search</field>
    <field name="model">internal_memo</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="type_id" />
                <field name="date" />
                <field name="title" />
                <field name="recipient_ids" />
            </xpath>
            <xpath expr="//filter[@name='grp_responsible']" position="after">
                <filter
                        name="grp_type"
                        string="Type"
                        context="{'group_by':'type_id'}"
                    />
                <filter name="grp_date" string="Date" context="{'group_by':'date'}" />
            </xpath>
        </data>
    </field>
</record>

<record id="internal_memo_view_form" model="ir.ui.view">
    <field name="name">internal_memo - Form</field>
    <field name="model">internal_memo</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="type_id" />
                <field name="recipient_ids" widget="many2many_tags_avatar" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
            </xpath>
            <xpath expr="//group[@name='header_center']" position="inside">
                <field name="title" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="memo" string="Memo">
                    <field name="memo" widget="html" />
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="internal_memo_action" model="ir.actions.act_window">
    <field name="name">Internal Memo</field>
    <field name="res_model">internal_memo</field>
    <field name="view_mode">tree,form</field>
</record>


<menuitem
        id="internal_memo_menu"
        name="Internal Memos"
        parent="menu_root_letter"
        groups="internal_memo_viewer_group"
        action="internal_memo_action"
        sequence="130"
    />

</odoo>
